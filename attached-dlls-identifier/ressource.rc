#define IDI_ICON1 1
// Icône (the file .ICO as to exist in the same folder)
IDI_ICON1 ICON "word.ico"
// Version Information
1 VERSIONINFO
FILEVERSION     0,0,0,1
PRODUCTVERSION  0,0,0,1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0" // Français (France), Unicode
        BEGIN
            VALUE "CompanyName", "John D."
            VALUE "FileDescription", "<DESCRIPTION>"
            VALUE "FileVersion", "0.0.0.1"
            VALUE "InternalName", "<INTERNAL NAME>"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "<ORIGINAL NAME>"
            VALUE "ProductName", "<PRODUCT NAME>"
            VALUE "ProductVersion", "0.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END